# Copy to ~/graphdispatch/.env.server on the host (never commit the real file). NO AWS key lines:
# Bedrock access comes from the EC2 instance role through the default boto3 credential chain.
GRAPH_NAME=sjfd
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
LLM_DAILY_CAP=150
# 1 only behind CloudFront or a load balancer that sets CloudFront-Viewer-Address or appends to X-Forwarded-For.
# Directly on the internet (plain HTTP first) keep 0 so a visitor cannot choose their own rate-limit key.
TRUST_PROXY=0
DEMO_EXPIRE_MIN=30
